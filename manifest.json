{
  "manifest_version": 3,
  "name": "Infinite Craft Explorer",
  "short_name": "ICX",
  "version": "1.0.0",
  "description": "Automatise Infinite Craft (neal.fun) : exploration priorisée des paires (bandit UCB/Thompson), cache persistant, AIMD, niveaux de puissance.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Infinite Craft Explorer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "permissions": ["sidePanel", "storage", "unlimitedStorage"],
  "host_permissions": ["https://neal.fun/*"],
  "content_scripts": [
    {
      "matches": ["https://neal.fun/infinite-craft/*"],
      "js": ["src/shared/pairkey.js", "src/page/net-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://neal.fun/infinite-craft/*"],
      "js": [
        "src/shared/pairkey.js",
        "src/shared/heap.js",
        "src/shared/aimd.js",
        "src/shared/scoring.js",
        "src/page/bridge.js",
        "src/page/store.js",
        "src/page/workers.js",
        "src/page/game.js",
        "src/page/power.js",
        "src/page/engine.js",
        "src/page/main.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://neal.fun/infinite-craft/*"],
      "js": ["src/content/bridge-content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/shared/pairkey.js", "src/shared/scoring.js", "src/worker/scorer-worker.js"],
      "matches": ["https://neal.fun/*"]
    }
  ]
}
